# Database connection URL for Prisma
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE
#
# For local development without Docker:
# DATABASE_URL="postgresql://username:password@localhost:5432/database_name"
#
# For development with Docker (running from host machine):
# The Docker postgres container exposes port 5432 to localhost
# DATABASE_URL="postgresql://username:password@localhost:5432/database_name"
#
# IMPORTANT: Change the username and password from these placeholder values
# Never commit real credentials to version control
DATABASE_URL="postgresql://username:password@localhost:5432/database_name"

# Application environment
NODE_ENV=development

# Note: When running in Docker, database credentials are managed via Docker secrets
# See secrets/README.md for Docker secrets setup instructions
