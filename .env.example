# Database connection URL for Prisma
# For local development without Docker: postgresql://tasteloop:tasteloop_dev_password@localhost:5432/tasteloop
# For development with Docker: postgresql://tasteloop:tasteloop_dev_password@postgres:5432/tasteloop
DATABASE_URL="postgresql://tasteloop:tasteloop_dev_password@localhost:5432/tasteloop"

# Application environment
NODE_ENV=development
