# Database Configuration
POSTGRES_USER=tasteloop
POSTGRES_PASSWORD=tasteloop_dev_password
POSTGRES_DB=tasteloop
DATABASE_URL=postgresql://tasteloop:tasteloop_dev_password@localhost:5432/tasteloop

# Application Configuration
NODE_ENV=development
PORT=3000

# Object Storage (DigitalOcean Spaces or local MinIO)
SPACES_ENDPOINT=http://localhost:9000
SPACES_REGION=us-east-1
SPACES_BUCKET=tasteloop-dev
SPACES_ACCESS_KEY_ID=minioadmin
SPACES_SECRET_ACCESS_KEY=minioadmin
# Force path-style URLs for local MinIO testing. Set to "false" for DigitalOcean Spaces.
SPACES_FORCE_PATH_STYLE=true
# Default ACL when uploading objects. Use "public-read" for public buckets or adjust as needed.
SPACES_OBJECT_ACL=public-read

# AI Providers
# Provide your OpenAI API key to enable recipe generation features.
OPENAI_API_KEY=
