# Application
NODE_ENV=development
PORT=8080

# Database
DATABASE_URL=postgresql://app:app@db:5432/appdb

# Redis/Valkey
REDIS_HOST=valkey
REDIS_PORT=6379
REDIS_URL=redis://valkey:6379
REDIS_DB=0
REDIS_PASSWORD=

# S3/Spaces (MinIO for local dev, DigitalOcean Spaces for production)
S3_ENDPOINT=http://minio:9000
S3_BUCKET=recipes-dev
S3_ACCESS_KEY_ID=minio
S3_SECRET_ACCESS_KEY=minio12345
S3_FORCE_PATH_STYLE=true
S3_REGION=us-east-1

# JWT
JWT_SECRET=devsecret

# Apple Sign-In
APPLE_CLIENT_ID=com.your.bundleid
APPLE_TEAM_ID=XXXXXX
APPLE_KEY_ID=XXXXXX
APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# Sentry (optional)
SENTRY_DSN=

# Demo/Public API
ENABLE_DEMO=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# PubSub (use Redis PubSub for horizontal scaling)
USE_REDIS_PUBSUB=false
